# --- Secrets (SECURITY-CRITICAL: never commit) ---
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.keystore.properties
keystore.properties
google-services.json

# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build output ---
dist/
dist-ssr/
build/
*.local
*.tsbuildinfo

# --- Capacitor native projects (generated by `cap add`) ---
android/
ios/
.gradle/

# --- Test artifacts ---
test-results/
playwright-report/
tests/screenshot/**/*-actual.png
tests/screenshot/**/*-diff.png
coverage/

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.log
npm-debug.log*

# --- Local runtime data (never commit user chat data / media) ---
/local-data/
*.aiwx
*.db
*.db-shm
*.db-wal

# --- User-supplied notification sound (personal, not redistributed) ---
public/sounds/message.*
