# --- Secrets (SECURITY-CRITICAL: never commit) ---
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.keystore.properties
keystore.properties
google-services.json

# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build output ---
dist/
dist-ssr/
build/
*.local
*.tsbuildinfo

# --- Capacitor native projects ---
# android/ is COMMITTED since M-I10 (it carries hand-written Kotlin: bubble,
# RemoteInput reply, call notification, widget). Generated pieces inside it are
# excluded by android/.gitignore. See docs/android-regen.md for the regen story.
ios/
.gradle/

# --- Test artifacts ---
test-results/
playwright-report/
tests/screenshot/**/*-actual.png
tests/screenshot/**/*-diff.png
coverage/

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.log
npm-debug.log*

# --- Local runtime data (never commit user chat data / media) ---
/local-data/
*.aiwx
*.db
*.db-shm
*.db-wal

# --- User-supplied notification sound (personal, not redistributed) ---
public/sounds/message.*
.claude/
