{
  "name": "weixin-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI \u5fae\u4fe1 \u2014 \u4e2a\u4eba\u81ea\u7528\u7684\u5fae\u4fe1\u590d\u523b + \u667a\u80fd\u4f53\u804a\u5929 App\uff08\u4e0d\u5546\u7528\u4e0d\u516c\u5f00\uff09",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . && node scripts/check-no-hardcoded-colors.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:screenshot": "playwright test",
    "test:screenshot:update": "playwright test --update-snapshots",
    "cap:sync": "cap sync",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "cap:add": "cap add android",
    "cap:apk": "pnpm build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/preferences": "^7.0.0",
    "drizzle-orm": "^0.38.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-virtuoso": "^4.12.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.0.0",
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
