<?xml version="1.0" encoding="utf-8"?>
<!-- Floating message chip shown by BubbleService over other apps.
     Root margins keep the chip off the very edges; the service drags it by
     mutating WindowManager.LayoutParams.y, not by re-laying-out this view. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/aiwx_bubble_bg"
    android:elevation="8dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/aiwx_widget_label" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/aiwx_bubble_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/aiwx_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/aiwx_bubble_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/aiwx_text_secondary"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
