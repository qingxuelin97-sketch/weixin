<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis=0: the launcher never polls; the app pushes fresh data
     through AiwxNativePlugin.updateWidget on every foreground pass and on
     backgrounding (src/native/widget-sync.ts). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/aiwx_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/aiwx_widget_description" />
