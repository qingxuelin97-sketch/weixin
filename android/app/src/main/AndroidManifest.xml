<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- AIWX deep links: aiwx://chat/<convId>, aiwx://call/<convId>?incoming=1 …
                 Every native surface (bubble tap, notification tap, RemoteInput
                 confirmation, call full-screen, widget) funnels through this one
                 filter; the JS side allowlists routes in src/native/deep-link.ts. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aiwx" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- AIWX (M-I10): floating message bubble drawn over other apps.
             Plain (non-foreground) service: it only lives while the app process
             does, which matches the JS producer — a WebView that is already dead
             cannot ask for a bubble anyway. -->
        <service
            android:name=".aiwx.BubbleService"
            android:exported="false" />

        <!-- AIWX: receives RemoteInput results + call-decline taps. Not exported —
             only our own PendingIntents (carrying the system's RemoteInput
             results) target it. -->
        <receiver
            android:name=".aiwx.ReplyReceiver"
            android:exported="false" />

        <!-- AIWX (M-J4): the exact alarm lands here, posts what is due and
             re-arms for the next item. Not exported — only our own alarm
             PendingIntent targets it. -->
        <receiver
            android:name=".aiwx.WakeAlarmReceiver"
            android:exported="false" />

        <!-- AIWX (M-J4): alarms do not survive a reboot but the snapshot does.
             Exported=false is correct even for BOOT_COMPLETED: the system
             delivers protected broadcasts to non-exported receivers. -->
        <receiver
            android:name=".aiwx.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- AIWX: home-screen widget (unread count + latest preview). -->
        <receiver
            android:name=".aiwx.AiwxWidgetProvider"
            android:exported="true"
            android:label="@string/aiwx_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aiwx_widget_info" />
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- AIWX (M-I10) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- M-J0: getUserMedia in the WebView needs BOTH declared, or Capacitor's
         onPermissionRequest is auto-DENIED without a prompt (undeclared runtime
         permissions never reach the user). Without these, ASR push-to-talk and
         call-page recording silently fail on every device. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- M-J6b: 视频通话的前置摄像头小窗（getUserMedia video）。同 RECORD_AUDIO：
         不声明 = WebView 权限请求被系统静默拒绝。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- M-J4b: 精确闹钟。不声明时 @capacitor/local-notifications 在 Android 12+
         全部退化成不精确投递（早安通知可能中午才到）。SCHEDULE_EXACT_ALARM 覆盖
         12-13（可在系统设置被用户关掉，插件会自动退回不精确）；USE_EXACT_ALARM
         在 14+ 自动授予——它有 Play 商店政策限制，但本 App 是个人侧载，不进店。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- M-J4: re-arm the wake alarms after a reboot. Without it the first
         message after the user restarts their phone is silently skipped until
         they next open the app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
